{
  "$schema": "https://tree-sitter.github.io/tree-sitter/cli/schema.json",
  "grammars": [
    {
      "name": "zeen",
      "scope": "source.zeen",
      "path": ".",
      "file-types": ["zn"]
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "description": "Tree-sitter grammar for the Zeen programming language",
    "license": "MIT",
    "authors": [{ "name": "mealet" }],
    "links": {
      "repository": "https://github.com/mealet/zeen-treesitter"
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
